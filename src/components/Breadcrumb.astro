---
interface Item {
  label: string;
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<style>
  nav {
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #666;
  }

  li:not(:last-child)::after {
    content: '>';
    color: #999;
  }

  a {
    color: #2d6a4f;
    font-weight: 600;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  span {
    color: #333;
    font-weight: 700;
  }
</style>

<nav>
  <ol>
    {
      items.map(({ label, href }) => (
        <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>
      ))
    }
  </ol>
</nav>
