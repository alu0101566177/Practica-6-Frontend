---
import BadgeThreat from './BadgeThreat.astro';
import Card from './Card.astro';
import type { SpecieSummary } from '@/data/types';

interface Props {
  specie: SpecieSummary;
}

const { id, name, icon, scientificName, location, threat, threatLabel } =
  Astro.props.specie;
---

<style>
  a {
    color: inherit;
    cursor: default;
    text-decoration: none;
  }

  .scientific {
    font-style: italic;
    font-size: 0.78rem;
    color: #666;
    margin: 0.1rem 0 0.5rem;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .badge-location {
    font-size: 0.72rem;
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
    background: #e8f5e9;
    color: #1b5e20;
  }
</style>

<a href=`/especie/${id}`>
  <Card>
    <span slot='title'>{name}</span>
    <span slot='icon'>{icon}</span>
    <p class='scientific'>{scientificName}</p>
    <div class='footer'>
      <span class='badge-location'>{location}</span>
      <BadgeThreat level={threat} label={threatLabel} />
    </div>
  </Card>
</a>
